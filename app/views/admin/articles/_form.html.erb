<%= form_with model: [ :admin, article ], class: "space-y-6" do |form| %>
  <%= render "shared/form_errors", record: article %>
  <%# The section is the one the piece was started from, and it stays there. %>
  <%= form.hidden_field :kind if article.new_record? %>

  <div class="rounded-xl border border-line bg-white p-6 space-y-6">
    <div>
      <%= form.label :title, class: "field-label" %>
      <%= form.text_field :title, required: true, autofocus: article.new_record?, class: "field-input" %>
    </div>

    <% if article.persisted? %>
      <%= render "admin/shared/public_link", url: article_url_for(article), record: article %>
    <% end %>

    <div>
      <%= form.label :excerpt, class: "field-label" %>
      <%= form.text_area :excerpt, rows: 2, class: "field-input resize-y" %>
    </div>

    <div>
      <%= form.label :cover_image, class: "field-label" %>
      <% if article.cover_image.attached? %>
        <%= image_tag article.cover_image.variant(resize_to_limit: [ 480, 300 ]), alt: "",
              class: "mb-3 w-48 rounded-lg object-cover" %>
      <% end %>
      <%= form.file_field :cover_image, accept: "image/*", class: "field-input" %>
    </div>

    <div>
      <%= form.label :published_at, class: "field-label" %>
      <%= form.datetime_field :published_at, class: "field-input" %>
      <p class="field-hint"><%= t("admin.shared.published_at_hint") %></p>
    </div>
  </div>

  <div class="rounded-xl border border-line bg-white p-6">
    <%= form.label :body, class: "field-label" %>
    <%= form.rich_textarea :body %>
    <p class="field-hint"><%= t("admin.shared.video_hint") %></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit article.new_record? ? t("admin.articles.sections.#{article.kind}.create") : t("admin.shared.save"),
          class: "btn btn-primary cursor-pointer" %>
    <%= link_to t("admin.shared.cancel"), admin_articles_path(kind: article.kind), class: "link-quiet text-sm text-ink-mute" %>
  </div>
<% end %>
