<% content_for :title, page_title(t("admin.enrollments.new")) %>
<%= render "admin/shared/header", title: t("admin.enrollments.new"), eyebrow: @course.title %>

<%= form_with model: [ :admin, @course, @enrollment ], class: "max-w-lg space-y-6" do |form| %>
  <%= render "shared/form_errors", record: @enrollment %>

  <div class="rounded-xl border border-line bg-white p-6 space-y-6">
    <div>
      <%= form.label :email_address, t("admin.enrollments.email_label"), class: "field-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, class: "field-input" %>
      <p class="field-hint"><%= t("admin.enrollments.email_hint") %></p>
    </div>

    <div>
      <%= form.label :name, t("admin.enrollments.name_label"), class: "field-label" %>
      <%= form.text_field :name, class: "field-input" %>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit t("admin.enrollments.new"), class: "btn btn-primary cursor-pointer" %>
    <%= link_to t("admin.shared.cancel"), admin_course_enrollments_path(@course), class: "link-quiet text-sm text-ink-mute" %>
  </div>
<% end %>
