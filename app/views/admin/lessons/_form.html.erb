<%= form_with model: [ :admin, course, lesson ], class: "space-y-6",
      data: {
        controller: "upload-progress video-source",
        action: "direct-upload:start->upload-progress#start " \
                "direct-upload:progress->upload-progress#progress " \
                "direct-upload:error->upload-progress#error " \
                "direct-upload:end->upload-progress#end",
        upload_progress_uploading_text_value: t("admin.lessons.uploading"),
        upload_progress_done_text_value: t("admin.lessons.upload_done"),
        upload_progress_error_text_value: t("admin.lessons.upload_error")
      } do |form| %>
  <%= render "shared/form_errors", record: lesson %>

  <div class="rounded-xl border border-line bg-white p-6 space-y-6">
    <div>
      <%= form.label :title, class: "field-label" %>
      <%= form.text_field :title, required: true, autofocus: lesson.new_record?, class: "field-input" %>
    </div>

    <div>
      <%= form.label :summary, class: "field-label" %>
      <%= form.text_area :summary, rows: 2, class: "field-input resize-y" %>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      <div>
        <%= form.label :position, class: "field-label" %>
        <%= form.number_field :position, min: 0, step: 1, class: "field-input" %>
      </div>

      <div>
        <%= form.label :duration_seconds, class: "field-label" %>
        <%= form.number_field :duration_seconds, min: 1, step: 1, class: "field-input" %>
        <p class="field-hint"><%= t("admin.lessons.duration_hint") %></p>
      </div>

      <div>
        <%= form.label :published_at, class: "field-label" %>
        <%= form.datetime_field :published_at, class: "field-input" %>
      </div>
    </div>

    <div class="border-t border-line pt-6">
      <%= render "admin/lessons/video_fields", form: form, lesson: lesson %>
    </div>
  </div>

  <div class="rounded-xl border border-line bg-white p-6">
    <%= form.label :notes, class: "field-label" %>
    <%= form.rich_textarea :notes %>
    <p class="field-hint"><%= t("admin.shared.video_hint") %></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit class: "btn btn-primary cursor-pointer disabled:opacity-50",
          data: { upload_progress_target: "submit" } %>
    <%= link_to t("admin.shared.cancel"), admin_course_lessons_path(course), class: "link-quiet text-sm text-ink-mute" %>
  </div>
<% end %>
