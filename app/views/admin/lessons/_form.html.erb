<%= form_with model: [ :admin, course, lesson ], class: "space-y-6",
      data: {
        controller: "upload-progress",
        action: "direct-upload:start->upload-progress#start " \
                "direct-upload:progress->upload-progress#progress " \
                "direct-upload:error->upload-progress#error " \
                "direct-upload:end->upload-progress#end",
        upload_progress_uploading_text_value: t("admin.lessons.uploading"),
        upload_progress_done_text_value: t("admin.lessons.upload_done"),
        upload_progress_error_text_value: t("admin.lessons.upload_error")
      } do |form| %>
  <%= render "shared/form_errors", record: lesson %>

  <div class="rounded-xl border border-line bg-white p-6 space-y-6">
    <div>
      <%= form.label :title, class: "field-label" %>
      <%= form.text_field :title, required: true, autofocus: lesson.new_record?, class: "field-input" %>
    </div>

    <div>
      <%= form.label :summary, class: "field-label" %>
      <%= form.text_area :summary, rows: 2, class: "field-input resize-y" %>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      <div>
        <%= form.label :position, class: "field-label" %>
        <%= form.number_field :position, min: 0, step: 1, class: "field-input" %>
      </div>

      <div>
        <%= form.label :duration_seconds, class: "field-label" %>
        <%= form.number_field :duration_seconds, min: 1, step: 1, class: "field-input" %>
      </div>

      <div>
        <%= form.label :published_at, class: "field-label" %>
        <%= form.datetime_field :published_at, class: "field-input" %>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :video_provider, class: "field-label" %>
        <%= form.select :video_provider, Lesson::VIDEO_PROVIDERS,
              { include_blank: true }, class: "field-input" %>
        <p class="field-hint"><%= t("admin.lessons.video_hint") %></p>
      </div>

      <div>
        <%= form.label :video_reference, class: "field-label" %>
        <%= form.text_field :video_reference, class: "field-input" %>
      </div>
    </div>

    <%# Only relevant when the video lives here rather than on YouTube or Vimeo. %>
    <div class="border-t border-line pt-6">
      <%= form.label :video, class: "field-label" %>

      <% if lesson.video.attached? %>
        <div class="mb-4 flex flex-wrap items-center gap-3 rounded-lg bg-haze px-4 py-3 text-sm">
          <span class="font-medium"><%= lesson.video.filename %></span>
          <span class="text-ink-mute"><%= number_to_human_size(lesson.video.byte_size) %></span>
          <label class="ml-auto flex items-center gap-2 text-rose">
            <%= form.check_box :remove_video, { class: "size-4 rounded border-line" }, "1", "0" %>
            <span><%= t("admin.lessons.remove_video") %></span>
          </label>
        </div>
      <% end %>

      <%# direct_upload sends the file from the browser straight to R2; without
          it a large video would be buffered through the app and the proxy. %>
      <%= form.file_field :video, accept: "video/*", direct_upload: true, class: "field-input" %>
      <p class="field-hint"><%= t("admin.lessons.video_file_hint") %></p>

      <div class="mt-4 hidden" data-upload-progress-target="wrapper">
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-line">
          <div class="h-full w-0 rounded-full bg-iris transition-[width] duration-200"
               data-upload-progress-target="bar"></div>
        </div>
        <p class="field-hint" data-upload-progress-target="status"></p>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-line bg-white p-6">
    <%= form.label :notes, class: "field-label" %>
    <%= form.rich_textarea :notes %>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit class: "btn btn-primary cursor-pointer disabled:opacity-50",
          data: { upload_progress_target: "submit" } %>
    <%= link_to t("admin.shared.cancel"), admin_course_lessons_path(course), class: "link-quiet text-sm text-ink-mute" %>
  </div>
<% end %>
