<% content_for :title, page_title(t("admin.pages.title")) %>

<%= render "admin/shared/header", title: t("admin.pages.title") %>

<div class="overflow-hidden rounded-xl border border-line bg-white">
  <ul class="divide-y divide-line">
    <% @pages.each do |page| %>
      <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-4">
        <div class="min-w-0 flex-1">
          <%= link_to page.title.presence || t("admin.pages.keys.#{page.key}"),
                edit_admin_page_path(page), class: "link-quiet font-medium" %>
          <p class="mt-1 text-sm text-ink-mute"><%= t("admin.pages.keys.#{page.key}") %> · <%= page.locale.upcase %></p>
        </div>

        <%= link_to t("admin.shared.preview"),
              (page.key == "about" ? about_path(locale: page.locale) : philosophy_path(locale: page.locale)),
              class: "link-quiet text-sm text-ink-soft" %>
      </li>
    <% end %>
  </ul>
</div>
