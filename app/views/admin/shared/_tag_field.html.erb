<%#
  The internal tags on a piece or a course. Never shown on the site: they are
  how a course is matched with the people who have read about its subject, so
  the same idea should always carry the same word.
%>
<% existing = Tag.alphabetical.pluck(:name) %>
<div data-controller="tag-list">
  <%= form.label :tag_list, t("admin.shared.tags"), class: "field-label" %>
  <%= form.text_field :tag_list, class: "field-input", autocomplete: "off",
        placeholder: t("admin.shared.tags_placeholder"), data: { tag_list_target: "input" } %>
  <p class="field-hint"><%= t("admin.shared.tags_hint") %></p>

  <% if existing.any? %>
    <div class="mt-3 flex flex-wrap gap-2">
      <% existing.each do |name| %>
        <button type="button" class="cursor-pointer rounded-full border border-line bg-white px-3 py-1 text-sm text-ink-soft hover:border-iris hover:text-iris"
                data-action="tag-list#add" data-tag-list-name-param="<%= name %>"><%= name %></button>
      <% end %>
    </div>
  <% end %>
</div>
