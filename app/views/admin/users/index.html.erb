<% content_for :title, page_title(t("admin.users.title")) %>

<%= render "admin/shared/header", title: t("admin.users.title") %>

<%= form_with url: admin_users_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-4" do |form| %>
  <div class="min-w-0 flex-1 sm:max-w-sm">
    <%= form.label :q, t("admin.users.search"), class: "field-label" %>
    <%= form.search_field :q, value: @query, placeholder: t("admin.users.search_placeholder"), class: "field-input" %>
  </div>
  <%= form.hidden_field :filter, value: @filter if @filter %>
  <%= form.submit t("admin.users.search_submit"), name: nil, class: "btn btn-ghost cursor-pointer py-2.5 px-5 text-sm" %>
<% end %>

<nav class="mb-6 flex flex-wrap gap-2 text-sm" aria-label="<%= t("admin.users.filter") %>">
  <% options = [ [ nil, t("admin.users.filters.all") ] ] +
               Admin::UsersController::FILTERS.map { |f| [ f, t("admin.users.filters.#{f}") ] } %>
  <% options.each do |value, label| %>
    <%= link_to label, admin_users_path(q: @query.presence, filter: value),
          class: class_names("rounded-full border px-4 py-1.5",
                             "border-iris bg-iris text-white" => @filter == value,
                             "border-line bg-white text-ink-soft hover:border-iris hover:text-iris" => @filter != value),
          aria: { current: ("page" if @filter == value) } %>
  <% end %>
</nav>

<% if @users.any? %>
  <div class="overflow-hidden rounded-xl border border-line bg-white">
    <ul class="divide-y divide-line">
      <% @users.each do |user| %>
        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-4 <%= "bg-rose/5" if user.deactivated? %>">
          <div class="min-w-0 flex-1">
            <%= link_to user.display_name, admin_user_path(user), class: "link-quiet font-medium" %>
            <p class="mt-1 truncate text-sm text-ink-mute"><%= user.email_address %></p>
          </div>

          <div class="flex flex-wrap items-center gap-2"><%= render "admin/users/badges", user: user %></div>

          <p class="w-full text-sm text-ink-mute sm:w-auto">
            <%= t("admin.users.courses_count", count: user.enrollments.size) %> ·
            <%= t("admin.users.joined_on", date: localized_date(user.created_at, format: :short_month)) %>
          </p>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-line bg-white p-12 text-center">
    <p class="text-ink-mute"><%= @query.present? ? t("admin.users.no_match", query: @query) : t("admin.users.empty") %></p>
  </div>
<% end %>
