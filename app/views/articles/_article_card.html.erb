<article class="group border-t border-line pt-6">
  <% if article.cover_image.attached? %>
    <%= link_to article_path(id: article), class: "mb-5 block overflow-hidden rounded-lg", tabindex: -1, aria: { hidden: true } do %>
      <%= image_tag article.cover_image.variant(resize_to_fill: [ 800, 500 ]), alt: "",
            class: "aspect-[8/5] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" %>
    <% end %>
  <% end %>

  <p class="text-xs tracking-wide text-ink-mute"><%= article_meta(article).join(" · ") %></p>

  <h3 class="mt-3 font-display text-2xl font-light">
    <%= link_to article.title, article_path(id: article), class: "link-quiet" %>
  </h3>

  <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft"><%= truncate(article.summary, length: 150) %></p>

  <% unless article.published? %>
    <p class="mt-3 text-xs font-semibold uppercase tracking-[0.14em] text-rose"><%= t("admin.shared.draft") %></p>
  <% end %>
</article>
