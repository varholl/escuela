<% section = "articles.sections.#{@kind}" %>
<% content_for :title, page_title(t("#{section}.title")) %>
<% content_for :description, meta_description(t("#{section}.body")) %>

<%= render "shared/page_header",
      eyebrow: t("#{section}.eyebrow"),
      title: t("#{section}.title"),
      body: t("#{section}.body") %>

<div class="mx-auto max-w-6xl px-6 pb-8">
  <% if @articles.any? %>
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      <%= render partial: "articles/article_card", collection: @articles, as: :article %>
    </div>
  <% else %>
    <p class="text-lg text-ink-mute"><%= t("#{section}.empty") %></p>
  <% end %>
</div>
