<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || page_title(t("admin.title")) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..600;1,6..72,200..500&family=Karla:ital,wght@0,300..700;1,300..600&display=swap">
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-haze">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-6 md:flex-row md:gap-8 md:px-6 md:py-8">
      <aside class="md:w-56 md:shrink-0">
        <%= link_to admin_root_path, class: "mb-6 hidden w-fit md:block" do %>
          <%= render "shared/wordmark", size: "h-8 w-8" %>
        <% end %>

        <%= render "admin/shared/nav" %>

        <div class="mt-6 hidden border-t border-line pt-5 text-sm md:block">
          <p>
            <%= link_to Current.user&.display_name, edit_admin_account_path,
                  class: "link-quiet text-ink-soft hover:text-iris" %>
          </p>
          <p class="mt-3">
            <%= link_to t("admin.nav.view_site"), root_path, class: "link-quiet text-ink-soft hover:text-iris" %>
          </p>
          <p class="mt-2">
            <%= button_to t("nav.sign_out"), session_path, method: :delete,
                  class: "link-quiet cursor-pointer text-ink-soft hover:text-iris" %>
          </p>
        </div>
      </aside>

      <div class="min-w-0 flex-1">
        <% flash.each do |level, message| %>
          <div class="mb-6 rounded-xl border-l-2 bg-white px-5 py-3.5 text-[0.9375rem] <%= flash_classes(level) %>"
               role="<%= level.to_s.in?(%w[alert error]) ? "alert" : "status" %>">
            <%= message %>
          </div>
        <% end %>

        <%= yield %>

        <div class="mt-10 flex items-center justify-between border-t border-line pt-5 text-sm md:hidden">
          <%= link_to t("admin.account.title"), edit_admin_account_path, class: "text-ink-soft" %>
          <%= link_to t("admin.nav.view_site"), root_path, class: "text-ink-soft" %>
          <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "cursor-pointer text-ink-soft" %>
        </div>
      </div>
    </div>
  </body>
</html>
