<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || page_title(t("site.tagline")) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || meta_description %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("site.name") %>">
    <meta name="theme-color" content="#fbf9fc">
    <% unless Rails.configuration.x.allow_indexing %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>

    <meta property="og:site_name" content="<%= t("site.name") %>">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="<%= I18n.locale %>">
    <meta property="og:title" content="<%= content_for(:title) || page_title(t("site.tagline")) %>">
    <meta property="og:description" content="<%= content_for(:description) || meta_description %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <%# Absolute URL: the crawlers that read these never resolve relative paths.
        A page may put its own picture forward -- a note offers its cover -- and
        it falls back to the school's card. Both are 1200x630, so the dimensions
        below hold either way. %>
    <% social_image = content_for(:social_image).presence || image_url("og-image.png") %>
    <meta property="og:image" content="<%= social_image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= content_for(:social_image_alt).presence || "#{t("site.name")} — #{t("site.tagline")}" %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= social_image %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..600;1,6..72,200..500&family=Karla:ital,wght@0,300..700;1,300..600&display=swap">

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-iris focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white">
      <%= t("nav.skip_to_content") %>
    </a>

    <%= render "shared/header" %>
    <%= render "shared/flash" %>

    <main id="content" class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer", flush: content_for?(:flush_footer) %>
  </body>
</html>
