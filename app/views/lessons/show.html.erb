<% content_for :title, page_title(@lesson.title, @course.title) %>

<article class="mx-auto max-w-4xl px-6 pt-16 pb-8 md:pt-20">
  <%= link_to t("lessons.show.back"), course_path(id: @course), class: "link-quiet text-sm text-ink-mute" %>

  <% unless @lesson.published? %>
    <p class="mt-6 rounded-xl border-l-2 border-rose bg-rose/10 px-5 py-3.5 text-[0.9375rem]">
      <%= t("articles.show.draft_notice") %>
    </p>
  <% end %>

  <header class="mt-6">
    <p class="eyebrow"><%= @course.title %></p>
    <h1 class="mt-4 text-[clamp(1.9rem,4.5vw,3rem)]"><%= @lesson.title %></h1>

    <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-mute">
      <% if @lesson.duration.present? %><span><%= @lesson.duration %></span><% end %>
    </p>
  </header>

  <% if lesson_has_player?(@lesson) %>
    <div class="mt-10"><%= render "lessons/player", lesson: @lesson %></div>
  <% end %>

  <% if @lesson.summary.present? %>
    <p class="mt-10 font-display text-xl font-light italic leading-snug text-ink-mute"><%= @lesson.summary %></p>
  <% end %>

  <% if @lesson.notes.present? %>
    <section class="mt-10">
      <h2 class="eyebrow"><%= t("lessons.show.materials") %></h2>
      <div class="prose-note mt-6"><%= @lesson.notes %></div>
    </section>
  <% elsif !lesson_has_player?(@lesson) %>
    <p class="mt-10 text-ink-mute"><%= t("lessons.show.no_content") %></p>
  <% end %>

  <nav class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-sm">
    <% if @previous %>
      <%= link_to "← #{@previous.title}", course_lesson_path(course_id: @course, id: @previous),
            class: "link-quiet text-ink-soft" %>
    <% else %>
      <span></span>
    <% end %>

    <% if @next %>
      <%= link_to "#{@next.title} →", course_lesson_path(course_id: @course, id: @next),
            class: "link-quiet font-semibold text-iris" %>
    <% end %>
  </nav>
</article>
