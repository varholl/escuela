<% content_for :title, page_title(t("passwords.edit.title")) %>

<h1 class="font-display text-2xl font-light"><%= t("passwords.edit.title") %></h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "mt-7 space-y-5" do |form| %>
  <div>
    <%= form.label :password, User.human_attribute_name(:password), class: "field-label" %>
    <%= form.password_field :password, required: true, autofocus: true,
          autocomplete: "new-password", class: "field-input" %>
  </div>

  <div>
    <%= form.label :password_confirmation, User.human_attribute_name(:password_confirmation), class: "field-label" %>
    <%= form.password_field :password_confirmation, required: true,
          autocomplete: "new-password", class: "field-input" %>
  </div>

  <%= form.submit t("passwords.edit.submit"), class: "btn btn-primary w-full cursor-pointer" %>
<% end %>
