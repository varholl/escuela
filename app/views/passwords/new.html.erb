<% content_for :title, page_title(t("passwords.new.title")) %>

<h1 class="font-display text-2xl font-light"><%= t("passwords.new.title") %></h1>
<p class="mt-2 text-sm text-ink-mute"><%= t("passwords.new.body") %></p>

<%= form_with url: passwords_path, class: "mt-7 space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, User.human_attribute_name(:email_address), class: "field-label" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", class: "field-input" %>
  </div>

  <%= form.submit t("passwords.new.submit"), class: "btn btn-primary w-full cursor-pointer" %>
<% end %>

<p class="mt-6 text-center text-sm">
  <%= link_to t("sessions.new.title"), new_session_path, class: "link-quiet text-ink-mute" %>
</p>
