<% content_for :title, page_title(t("preferences.title")) %>

<%= render "shared/page_header",
      eyebrow: t("nav.library"),
      title: t("preferences.title"),
      body: t("preferences.body"),
      back: { label: t("preferences.back"), path: library_path } %>

<div class="mx-auto max-w-2xl px-6 pb-8">
  <%= form_with model: @user, url: preferences_path, method: :patch, class: "space-y-6" do |form| %>
    <%= render "preferences/consents", form: form %>

    <%= form.submit t("preferences.save"), class: "btn btn-primary cursor-pointer" %>
  <% end %>

  <p class="mt-10 text-sm text-ink-mute">
    <%= t("preferences.privacy_html", link: link_to(t("nav.privacy"), privacy_path, class: "link-quiet text-iris")) %>
  </p>
</div>
