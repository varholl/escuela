<% content_for :title, page_title(t("sessions.new.title")) %>

<h1 class="font-display text-2xl font-light"><%= t("sessions.new.title") %></h1>
<p class="mt-2 text-sm text-ink-mute"><%= t("sessions.new.body") %></p>

<%= form_with url: session_path, class: "mt-7 space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, User.human_attribute_name(:email_address), class: "field-label" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", class: "field-input" %>
  </div>

  <div>
    <%= form.label :password, User.human_attribute_name(:password), class: "field-label" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", class: "field-input" %>
  </div>

  <%= form.submit t("sessions.new.submit"), class: "btn btn-primary w-full cursor-pointer" %>
<% end %>

<% if ApplicationMailer.enabled? %>
  <p class="mt-6 text-center text-sm">
    <%= link_to t("sessions.new.forgot_password"), new_password_path, class: "link-quiet text-ink-mute" %>
  </p>
<% else %>
  <p class="mt-6 text-center text-sm text-ink-mute">
    <%= t("sessions.new.no_recovery_html", contact: link_to(t("nav.contact"), new_contact_path, class: "link-quiet text-iris")).html_safe %>
  </p>
<% end %>
