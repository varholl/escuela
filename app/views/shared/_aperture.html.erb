<%#
  The mark is a tilted ellipse drawn around free calligraphy: a precise frame
  holding something handmade. The hero rebuilds that frame at full scale and
  puts her portrait inside it. Until she uploads one, the frame holds a slow
  bloom that expands and contracts at a resting breath rate.
%>
<%
  image = local_assigns[:image]
  gradient_id = "aperture-stroke-#{local_assigns.fetch(:id, "hero")}"
%>
<div class="relative aspect-square w-full">
  <div class="absolute inset-[-8%] rounded-full bg-iris-pale/40 blur-3xl" aria-hidden="true"></div>

  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="<%= gradient_id %>" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%"   stop-color="var(--color-iris)" />
        <stop offset="48%"  stop-color="var(--color-rose)" />
        <stop offset="100%" stop-color="var(--color-gold-bright)" />
      </linearGradient>
    </defs>
    <ellipse cx="50" cy="50" rx="47" ry="41" transform="rotate(-14 50 50)"
             fill="none" stroke="url(#<%= gradient_id %>)" stroke-width="1.5" />
  </svg>

  <div class="absolute inset-0 grid place-items-center">
    <div class="h-[82%] w-[94%] -rotate-[14deg] overflow-hidden rounded-[50%]">
      <% if image&.attached? %>
        <%= image_tag image.variant(resize_to_fill: [ 900, 900 ]),
              alt: local_assigns.fetch(:alt, ""),
              class: "h-full w-full rotate-[14deg] scale-125 object-cover" %>
      <% else %>
        <div class="breathe h-full w-full rounded-[50%]"
             style="background: radial-gradient(circle at 42% 36%,
                       rgba(249, 198, 9, 0.42) 0%,
                       rgba(176, 99, 106, 0.34) 34%,
                       rgba(119, 23, 181, 0.24) 62%,
                       rgba(119, 23, 181, 0) 84%);
                    filter: blur(10px);"></div>
      <% end %>
    </div>
  </div>
</div>
