<% if flash.any? %>
  <div class="mx-auto w-full max-w-3xl px-6 pt-6">
    <% flash.each do |level, message| %>
      <div class="rounded-xl border-l-2 px-5 py-3.5 text-[0.9375rem] <%= flash_classes(level) %>"
           role="<%= level.to_s.in?(%w[alert error]) ? "alert" : "status" %>">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>
