<%# Her profiles elsewhere. The caller sets the classes because this appears
    both on the dark footer and on light pages. %>
<ul class="<%= local_assigns.fetch(:list_class, "space-y-3") %> text-[0.9375rem]">
  <% social_links.each do |link| %>
    <li>
      <%# rel="me" is how these profiles and the site vouch for each other. %>
      <%= link_to link[:url], rel: "me noopener", target: "_blank",
            class: "link-quiet inline-flex items-center gap-2.5 #{local_assigns.fetch(:link_class, "")}" do %>
        <%= render "shared/social_icon", icon: link[:icon] %>
        <span><%= link[:label] %></span>
      <% end %>
    </li>
  <% end %>
</ul>
